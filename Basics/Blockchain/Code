import random

# --- Finite Field Arithmetic ---

def modular_inverse(a, m):
    """Calculates the modular multiplicative inverse of a modulo m.
    Uses Fermat's Little Theorem: a^(m-2) % m, as m is prime.
    """
    if m == 0:
        raise ValueError("Modulus cannot be zero.")
    if pow(a, m - 2, m) * a % m != 1:
        # This can happen if a is a multiple of m, or m is not prime
        # For simplicity here, we assume m is prime and a is not a multiple of m
        raise ValueError(f"No modular inverse for {a} mod {m}. Is {m} prime and {a} not a multiple of {m}?")
    return pow(a, m - 2, m)

# --- Shamir's Secret Sharing ---

def generate_shares(secret, n, k, prime):
    """
    Generates n shares for a given secret, requiring k shares to reconstruct.
    All calculations are done modulo prime.

    Args:
        secret (int): The secret number to share.
        n (int): The total number of shares to generate.
        k (int): The minimum number of shares required to reconstruct the secret (threshold).
        prime (int): A prime number larger than the secret and n.

    Returns:
        list: A list of (x, y) tuples, where each tuple is a share.
    """
    if k <= 0 or n < k:
        raise ValueError("Invalid parameters: k must be > 0 and n must be >= k.")
    if secret >= prime:
        raise ValueError("Secret must be smaller than the prime modulus.")
    if n >= prime:
        # x-coordinates for shares are 1, 2, ..., n.
        # If n >= prime, we might not have enough distinct x-coordinates or x_i - x_j could be 0 mod prime.
        raise ValueError("n must be smaller than the prime modulus to ensure distinct x-coordinates for shares.")

    # 1. Generate a random polynomial of degree k-1
    # P(x) = a_0 + a_1*x + ... + a_{k-1}*x^{k-1}
    # a_0 is the secret
    coefficients = [secret] + [random.randint(1, prime - 1) for _ in range(k - 1)]
    # print(f"Polynomial coefficients (a_0=secret, a_1, ...): {coefficients}")

    shares = []
    for i in range(1, n + 1):
        x = i
        y = 0
        # Evaluate P(x) = sum(coeff_j * x^j for j in range(k))
        for power, coeff in enumerate(coefficients):
            y = (y + coeff * pow(x, power, prime)) % prime
        shares.append((x, y))

    return shares

def reconstruct_secret(shares_subset, prime):
    """
    Reconstructs the secret from a subset of k shares using Lagrange Interpolation.
    The secret is P(0).

    Args:
        shares_subset (list): A list of at least k (x, y) tuples (shares).
        prime (int): The prime number used during share generation.

    Returns:
        int: The reconstructed secret.
    """
    if not shares_subset:
        raise ValueError("Shares subset cannot be empty.")

    # The number of shares provided determines k for reconstruction
    k_reconstruct = len(shares_subset)
    if k_reconstruct == 0:
        raise ValueError("Cannot reconstruct with zero shares.")

    reconstructed_secret = 0

    for j in range(k_reconstruct):
        xj, yj = shares_subset[j]
        
        numerator = 1
        denominator = 1
        
        for m in range(k_reconstruct):
            if m == j:
                continue
            xm, _ = shares_subset[m]
            
            # L_j(0) = product_{m!=j} (-x_m) / (x_j - x_m)
            numerator = (numerator * (-xm)) % prime
            denominator = (denominator * (xj - xm)) % prime
            
        if denominator == 0:
            raise ValueError("Denominator is zero, cannot compute modular inverse. "
                             "This can happen if x-coordinates in shares are not distinct or k is too small.")

        # (yj * numerator * modInverse(denominator, prime))
        term = (yj * numerator * modular_inverse(denominator, prime)) % prime
        reconstructed_secret = (reconstructed_secret + term) % prime
        
    return reconstructed_secret


    
